# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 2
  metrics: count: method: 2

  entity: conversationsinfo: {
    path: "/conversations.info": {
      op: load: method: *GET
      op: load: transform: res: *("`body.channel`")|top
    }
  }

  entity: conversationslist: {
    path: "/conversations.list": {
      op: list: method: *GET
      op: list: transform: res: *("`body.channels`")|top
    }
  }

}