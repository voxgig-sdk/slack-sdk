# BasicAuthFlow

main: kit: flow: BasicAuthFlow:
{
  entity: "auth",
  kind: "basic",
  name: "BasicAuthFlow",
  step: [
    {
      input: {
        ref: "auth_ref01",
        srcdatavar: "auth_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-auth_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAuthFlow"
}