# BasicBotFlow

main: kit: flow: BasicBotFlow:
{
  entity: "bot",
  kind: "basic",
  name: "BasicBotFlow",
  step: [
    {
      input: {
        ref: "bot_ref01",
        srcdatavar: "bot_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-bot_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBotFlow"
}