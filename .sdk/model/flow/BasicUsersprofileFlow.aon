        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-usersprofile_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicUsersprofileFlow"
