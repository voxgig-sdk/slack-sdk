# BasicAdminconversationFlow

main: kit: flow: BasicAdminconversationFlow:
{
  entity: "adminconversation",
  kind: "basic",
  name: "BasicAdminconversationFlow",
  step: [
    {
      input: {
        ref: "adminconversation_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "adminconversation_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "adminconversation_ref01",
        srcdatavar: "adminconversation_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-adminconversation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAdminconversationFlow"
}